# Required: comma-separated allowlist shown on the bucket selection page.
BUCKET_NAMES=bucket-a,bucket-b,bucket-c

# Web login credentials. Change these values before exposing the service.
LOGIN_USERNAME=admin
LOGIN_PASSWORD="#cloud01"

# Login session duration. Set TRUST_PROXY=true only when one trusted reverse
# proxy is directly in front of this container and supplies X-Forwarded-Proto.
SESSION_TTL_HOURS=8
TRUST_PROXY=false

# Absolute path to the service account JSON key on the VM.
# Keep this file outside the project directory and restrict its permissions.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/opt/gcs-filedownload-page/secrets/service-account.json

# The safe default exposes the service only on the VM loopback interface.
# Use 0.0.0.0 only when direct network access is intentionally required.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080

# Optional image/container names.
IMAGE_NAME=gcs-filedownload-page
IMAGE_TAG=latest
CONTAINER_NAME=gcs-filedownload-page
